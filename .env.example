# Copier vers .env, jamais commiter .env (secrets en clair). Sur le VPS,
# restreindre les permissions : chmod 600 .env

# Bot Telegram (créé via @BotFather) et chat_id destinataire
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Identifiants AL'in
ALIN_EMAIL=your_email@example.com
ALIN_PASSWORD=your_password_here
ALIN_LOGIN_URL=https://al-in.fr/#/login

# Optionnel : override si AL'in change sa clé x-gexrt-api-key (valeur publique)
# ALIN_GEXRT_API_KEY=

# Optionnel : identifiants logement-actionlogement.fr (stub non implémenté)
# LOGEMENT_ACTIONLOGEMENT_EMAIL=
# LOGEMENT_ACTIONLOGEMENT_PASSWORD=

# Fréquence de vérification (secondes), défaut 180
CHECK_INTERVAL_SECONDS=180

# Score minimum pour notifier, défaut 0 (tout notifier)
SCORE_THRESHOLD=0

DB_PATH=data/alin_monitor.db
STORAGE_STATE_PATH=data/storage_state.json
LOG_LEVEL=INFO

# Fallback Playwright manuel (MFA/CAPTCHA) : nécessite un affichage
# graphique, à garder à true en local uniquement. false sur VPS/Docker
# (déjà forcé par le Dockerfile, pas besoin de le redéfinir ici).
ENABLE_MANUAL_FALLBACK=true

# Chemin local de la clé age (déchiffrement .env.enc), cf. scripts/*.sh
AGE_KEY_FILE=~/.config/alin-monitor/age-key.txt
